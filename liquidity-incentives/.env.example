# Server-side public endpoint configuration. Never set VITE_RPC_* credentials.
# RPC_ROBINHOOD is required for live Robinhood pool reads.
# It also verifies catalog pair metadata and the factory-owner admin wallet.
# RPC_ROBINHOOD=
# RPC_ARBITRUM=
# Payment/database settings are process environment variables for npm run serve.
# VAULT_REQUEST_PAYMENT_ADDRESS=
# SAFFRON_DB_HOST=/var/run/postgresql
# SAFFRON_DB_USER=saffron_incentives
# SAFFRON_DB_NAME=saffron_incentives
# Optional handoff: set as PROCESS environment variables, with SAFFRON_DB_*
# pointing to the same migrated database as the target fixed-income API.
# SAFFRON_DB_SCHEMA_MODE=fixed-income
# FIXED_INCOME_FRONTEND_URL=http://localhost:3000
# FIXED_INCOME_API_URL=http://localhost:3100
