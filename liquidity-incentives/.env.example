# Server-side public endpoint configuration. Never set VITE_RPC_* credentials.
# RPC_ROBINHOOD is required for live Robinhood pool reads.
# It also verifies catalog pair metadata and vault readiness.
# RPC_ROBINHOOD=
# RPC_ARBITRUM=
# Payment/database settings are process environment variables for npm run serve.
# VAULT_REQUEST_PAYMENT_ADDRESS=
# SAFFRON_DB_HOST=/var/run/postgresql
# SAFFRON_DB_USER=saffron_incentives
# SAFFRON_DB_NAME=saffron_incentives
# Operator policy uses public addresses, not restricted-factory ownership.
# SAFFRON_DB_SCHEMA_MODE=standalone
# SAFFRON_ADMIN_WALLETS=
# SAFFRON_CREATOR_ADDRESS=
# SAFFRON_APP_ORIGIN=http://localhost:3201
# The creator EOA is never an environment variable or a web-server credential.
# See ops/README.md for protected worker configuration.
