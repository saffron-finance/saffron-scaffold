# Local .env is ignored. Process environment takes precedence.
PORT=3201
BIND_HOST=127.0.0.1
BASE_PATH=
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=saffron_incentives
PGDATABASE=saffron_incentives
PGPASSWORD=
# Server-side services. Never put credentials in VITE_* variables.
RPC_ROBINHOOD=
PRICE_API_ROOT=
# Public protocol only; see ops/protocol.example.json. Quote paths with spaces.
SAFFRON_PROTOCOL_CONFIG=
# Exact browser origin: 5187 for Vite, 3201 for the built app.
SAFFRON_APP_ORIGIN=http://127.0.0.1:5187
# Comma-separated public operator addresses. No private keys.
SAFFRON_ADMIN_WALLETS=
# Public native-ETH fee receiver; $2 fee quoting is disabled until configured.
SAFFRON_CREATION_FEE_RECIPIENT=
# Optional shell/relay inspection, with application API disabled:
# SAFFRON_API_DISABLED=1
# Optional PUBLIC add-chain URL; this is visible in the browser bundle:
# VITE_WALLET_RPC_ROBINHOOD=
# Set consistently in the build/server process for a path mount:
# VITE_BASE_PATH=/incentives/
# BASE_PATH=/incentives
