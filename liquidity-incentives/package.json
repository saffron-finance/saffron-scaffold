    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/react-modal": "^3.16.3",
    "@types/styled-components": "^5.1.36",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "^4.3.1",
