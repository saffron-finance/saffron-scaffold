{
  "name": "saffron-scaffold-incentives",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:lab": "node scripts/build-lab.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/admin-health.test.mjs tests/admin-configuration.test.mjs tests/proxy.test.mjs tests/dev-proxy.test.mjs tests/lifecycle-unit.test.mjs tests/incentives-auth.test.mjs tests/campaign-payment.test.mjs tests/gas-policy.test.mjs tests/live-deployment-regressions.test.mjs tests/protected-files.test.mjs tests/payment-records.test.mjs tests/creation-fee.test.mjs tests/checkout-readiness.test.mjs tests/vault-tvl.test.mjs tests/refund-proof.test.mjs",
    "serve": "node server/proxy.mjs",
    "test:browser": "playwright test",
    "test:database": "node --test tests/incentives-database.test.mjs tests/incentives-api.test.mjs tests/campaign-database.test.mjs tests/payment-resolutions.test.mjs tests/advisory-capacity.test.mjs tests/refunds-database.test.mjs",
    "test:lifecycle": "node --test tests/incentives-evm.test.mjs tests/real-position.test.mjs tests/worker-recovery.test.mjs tests/refunds-evm.test.mjs tests/pair-discovery.test.mjs",
    "worker": "node worker/run.mjs",
    "worker:inspect": "node worker/inspect.mjs",
    "worker:one": "node worker/run-one.mjs",
    "worker:payments": "node worker/run-payments.mjs",
    "worker:simulate": "node worker/simulate.mjs",
    "test:watcher": "node --test tests/payment-watcher.test.mjs tests/intake-policy.test.mjs tests/one-shot.test.mjs tests/protected-worker.test.mjs",
    "test:restore": "node --test tests/restore-database.test.mjs",
    "worker:restore-check": "node worker/check-restore.mjs",
    "demo": "node tests/demo.mjs",
    "test:operator-fork": "node ops/live-tests/2026-09-11-vault-2/recovery-fork.mjs",
    "test:vnc": "node --test ops/vnc/tests/*.test.mjs"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "react": "18.3.1",
    "react-currency-input-field": "^3.10.0",
    "react-dom": "18.3.1",
    "react-modal": "3.16.3",
    "styled-components": "5.3.11",
    "three": "0.185.1",
    "viem": "^2.55.17",
    "@walletconnect/ethereum-provider": "2.24.0",
    "@reown/appkit": "1.8.19"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "^4.9.6",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/react-modal": "^3.16.3",
    "@types/styled-components": "^5.1.36",
    "@types/three": "0.185.4",
    "@uniswap/v3-core": "^1.0.1",
    "@uniswap/v3-periphery": "^1.4.4",
    "@vitejs/plugin-react": "^4.3.1",
    "solc": "^0.8.18",
    "typescript": "^5.5.4",
    "vite": "^6.4.3",
    "vite-plugin-svgr": "^4.5.0"
  },
  "optionalDependencies": {
    "@foundry-rs/anvil-darwin-arm64": "1.7.1",
    "@foundry-rs/anvil-darwin-amd64": "1.7.1",
    "@foundry-rs/anvil-linux-arm64": "1.7.1",
    "@foundry-rs/anvil-linux-amd64": "1.7.1",
    "@foundry-rs/anvil-win32-amd64": "1.7.1"
  },
  "overrides": {
    "@coinbase/cdp-sdk": {
      "axios": "1.20.0"
    }
  }
}
