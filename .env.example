# RPC endpoints. Copy this file to `.env` and paste your QuickNode HTTP Provider URLs (they embed a
# secret token, so `.env` is gitignored — never commit it).
#
# Leave any of them blank to fall back to the public RPC defaults in src/chain/chains.ts.
# Ethereum and Arbitrum have public fallbacks; Robinhood Chain needs an endpoint to show up at all.
#
# How the token stays private:
#   - `npm run dev`   → the browser calls the RPC directly, so the URL IS visible locally. Fine for dev.
#   - `npm start`     → production. The build never embeds the token (verified: `grep quiknode dist/`
#                       is empty); the app calls the same-origin proxy `/rpc/<chain>` and the Node
#                       server in server/proxy.mjs adds the token server-side. The proxy also only
#                       forwards a read-only JSON-RPC allowlist, so a public URL can't drain the quota.
#     In production you can instead set RPC_ETHEREUM / RPC_ARBITRUM / RPC_ROBINHOOD in the host env.

VITE_RPC_ETHEREUM=
VITE_RPC_ARBITRUM=
VITE_RPC_ROBINHOOD=

# Server-only LI.FI contract-call quote settings. These are read by
# `npm run serve`; Vite exposes only VITE_* variables to browser code.
# Keep the real file gitignored and mode 0600. Never rename the key to VITE_*.
LIFI_API_KEY=
LIFI_INTEGRATOR=saffron-lifi
ZAP_QUOTES_ENABLED=true
RATE_LIMIT_ZAP_QUOTE_GLOBAL_PER_MIN=60
