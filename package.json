{
  "name": "saffron-scaffold",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Saffron Scaffold: inspect Saffron variable-side capacity and deposit through an injected wallet.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:mock": "VITE_USE_MOCK_DATA=true npm run build",
    "preview": "vite preview",
    "serve": "node server/proxy.mjs",
    "start": "npm run build && node server/proxy.mjs",
    "test": "vitest run",
    "test:server": "node --test server/proxy.test.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^3.2.6"
  }
}
