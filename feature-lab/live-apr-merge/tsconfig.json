{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "vite-plugin-svgr/client",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@fixed/*": [
        "vendor/fixed-income-ui/*"
      ],
      "@packages/onchain-config/live-pool-apr/pools.json": [
        "vendor/live-apr-shared/pools.json"
      ],
      "@packages/api-types/live-pool-apr.mjs": [
        "vendor/live-apr-shared/live-pool-apr.d.mts"
      ],
      "@lab/*": [
        "src/adapters/*"
      ],
      "@merge/session": [
        "src/merge/live-session.tsx"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ],
  "exclude": [
    "src/**/*.test.*",
    "src/livePoolApr/testing"
  ]
}
