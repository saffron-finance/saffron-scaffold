# Optional public build settings, never credentials.
VITE_BASE_PATH=/
# Host a compatible, authenticated read-only API at this same-origin path.
VITE_LIVE_APR_API_BASE=/api/live-apr/v2
# Optional external directory link. Omit it when installed elsewhere.
# VITE_FEATURE_LAB_HREF=/saffron/apps/feature-lab/
# VITE_PROTOCOL_APP_URL=https://app.saffron.finance
# Optional public Reown project ID (32 hex characters); enables WalletConnect in live builds.
# Configure allowed HTTPS origins in the Reown dashboard. This is not a secret.
VITE_WALLETCONNECT_PROJECT_ID=
# Optional public URL for wallets that need Robinhood Chain added explicitly:
# VITE_WALLET_RPC_ROBINHOOD=
